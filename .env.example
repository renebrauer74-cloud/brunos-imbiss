APP_NAME="Bruno's Imbiss"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://brunoimbisss.test
APP_TIMEZONE=Europe/Berlin

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Lokal: SQLite (database/database.sqlite)
DB_CONNECTION=sqlite

# Produktion (IONOS MariaDB) – statt der Zeile oben:
# DB_CONNECTION=mariadb
# DB_HOST=db5000000000.hosting-data.io
# DB_PORT=3306
# DB_DATABASE=dbs00000000
# DB_USERNAME=dbu00000000
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Bilder (Media Library) – lokal/IONOS: public/uploads, Laravel Cloud: Bucket-Disk
MEDIA_DISK=uploads
UPLOAD_MAX_KILOBYTES=20480

# Alte Plain-PHP-Version (nur für php artisan bruno:import-legacy)
LEGACY_DB_CONNECTION=mysql
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=bruno_imbiss
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=
LEGACY_UPLOADS_PATH=
